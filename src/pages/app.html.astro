---
const APP_NAME = "Matpris";
const TAGLINE = "Prisbevisst dagligvarehandel, tilbudsavis og handleliste";

const IOS_URL = "https://apps.apple.com/us/app/matlat/id6450923842";
const ANDROID_URL =
  "https://play.google.com/store/apps/details?id=com.kjellhaaland.matlat";
const WEBSITE_URL = "https://matpris.ai";
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1"
    />
    <title>Last ned Matpris</title>

    <!-- Sosial -->
    <meta property="og:title" content="Last ned Matpris" />
    <meta property="og:description" content={TAGLINE} />
    <meta property="og:image" content="/opengraph.jpg" />
    <meta property="og:type" content="website" />

    <!-- Viktig for TikTok -->
    <meta name="format-detection" content="telephone=no" />

    <style>
      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: #ffffff;
        color: #111111;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Helvetica,
          Arial,
          sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .card {
        width: 100%;
        max-width: 420px;
        padding: 32px;
        text-align: center;
      }

      .logo {
        width: 72px;
        height: 72px;
        margin: 0 auto 16px;
        border-radius: 16px;
        background: #2a9b64;
        color: white;
        font-weight: 800;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      h1 {
        margin: 0 0 8px;
        font-size: 24px;
      }

      p {
        margin: 0 0 24px;
        color: #666666;
        font-size: 15px;
      }

      a.button {
        display: block;
        padding: 14px 16px;
        margin-bottom: 12px;
        border-radius: 12px;
        text-decoration: none;
        font-size: 16px;
        font-weight: 700;
        line-height: 1.2;
        background: #ffffff;
        color: #111111;
        border: 1px solid #e5e5e5;
      }

      a.button.primary {
        background: #2a9b64;
        color: #ffffff;
        border-color: #2a9b64;
      }

      .secondary {
        margin-top: 16px;
        font-size: 14px;
      }

      .secondary a {
        color: #2a9b64;
        text-decoration: none;
        font-weight: 600;
      }

      .footer {
        margin-top: 20px;
        font-size: 12px;
        color: #888888;
      }
    </style>
  </head>

  <body>
    <main class="card">
      <div class="logo">matpris</div>

      <h1>{APP_NAME}</h1>
      <p>{TAGLINE}</p>

      <a class="button primary" href={IOS_URL}>Last ned på App Store</a>

      <a class="button" href={ANDROID_URL}>Få den på Google Play</a>

      <div class="secondary">
        <a href={WEBSITE_URL}>Lær mer / gå til nettsiden →</a>
      </div>
    </main>
  </body>
</html>

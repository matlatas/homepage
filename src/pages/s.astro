---
import Base from "@/layouts/Base.astro";
import Features from "@/partials/Features.astro";

import Faq from "@/partials/Faq.astro";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const company = (await getEntry(
  "company",
  "-index",
)) as CollectionEntry<"company">;
const { image } = company.data;
---

<Base
  title="Invitasjon til handleliste"
  meta_title="Du har blitt invitert til en handleliste | Matpris.ai"
  description="Du har blitt invitert til en handleliste på Matpris.ai. Klikk på knappen under for å åpne handlelisten og se hvilke varer som er lagt til."
  image={image}>
  <Features />
  <Faq />
</Base>

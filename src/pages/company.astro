---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import AboutBanner from "@/partials/CompanyBanner.astro";
import Faq from "@/partials/Faq.astro";
import OurTeam from "@/partials/OurTeam.astro";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const company = (await getEntry(
  "company",
  "-index",
)) as CollectionEntry<"company">;
const { title, description, meta_title, image } = company.data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}>
  <AboutBanner />
  <Faq />
  <CallToAction />
</Base>

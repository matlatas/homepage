---
import { Picture } from "astro:assets";
import heroImage from "assets/hero-1.png";
import Link from "@components/ui/link.astro";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6 md:order-1 hidden md:block">
    <Picture
      src={heroImage}
      alt="App Promo Screenshot"
      widths={[200, 400, 600]}
      height={800}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      format="avif"
    />
  </div>
  <div>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      Mattilbud på en smartere måte
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      Matpris-appen hjelper deg å spare penger, unngå dårlige lokketilbud og velge gode og sunne matvarer. Vi vurderer alle mattilbudene hver uke, slik at du kan ta smartere valg når du handler 🎲
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link
        href="#"
        href="/last-ned"
        target="_blank"
        class="flex gap-1 items-center justify-center"
        rel="noopener">
         Last ned appen
      </Link>
    </div>
  </div>
</main>

---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
{
    title: "Prisvurdering",
    description: "Vi vurderer alle mattilbud hver uke og triller terning på pris sammenlignet med sammenlignbare produkter fra butikkene.",
    icon: "bx:bxs-barcode",
  },
  {
    title: "Søk og filtrer",
    description: "Lei av å bla i lange tilbudsaviser? Søk og filtrer blant hundrevis av produkter.",
    icon: "bx:bxs-flask",
  },
  {
    title: "Sunnhetsvurdering",
    description: "Vanskelig å vite om maten er sunn eller ikke? Vi vurderer sunnheten til alle mattilbud hver uke.",
    icon: "bx:bxs-factory",
  },
];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Alt du trenger!
  </h2>
  <p class="text-lg mt-4 text-slate-600">
    Matpris-appen er utviklet for å gjøre det enklere for deg å ta gode matvalg når du handler. <br />Vi vurderer alle mattilbud hver uke og triller terning på pris og sunnhet.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>

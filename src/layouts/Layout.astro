<!-- TikTok Pixel Code End -->

    <!-- <link rel="preload" as="image" href={src} alt="Hero" /> -->
    <SEO
      title={makeTitle}
      description="Matlat er appen som hjelper deg å spise sunt og billig. Sjekk maten for e-stoffer og allergener eller om den er ultraprosessert."
      canonical={canonicalURL}
      twitter={{
        creator: "@matlat",
        site: "@web3templates",
        card: "summary_large_image",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `Matlat - Ta gode matvalg`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Matlat Homepage Screenshot",
        },
      }}
    />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
